# PostHog (optional). Analytics stay disabled while the key is empty.
# Project API key: https://app.posthog.com/project/settings
VITE_POSTHOG_KEY=
# Optional API host. EU cloud: https://eu.i.posthog.com  (default: https://us.i.posthog.com)
VITE_POSTHOG_HOST=

# Loops (required). Every CTA band signup becomes a Loops contact; there is no other store, so
# the app refuses to start without these.
# API key: https://app.loops.so/settings?page=api
LOOPS_API_KEY=
# The two mailing lists a signup joins, by side. Mailing lists can only be created in the Loops
# dashboard (the API refuses); copy each id from https://app.loops.so/audience/lists
LOOPS_PLAYERS_LIST_ID=
LOOPS_CLUBS_LIST_ID=
